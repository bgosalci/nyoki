// Nyoki storefront + CMS data model.
//
// MONEY IS ALWAYS AN INTEGER NUMBER OF PENCE. Never a float, never pounds.
// Stripe works in the smallest currency unit too, so amounts pass straight
// through without conversion and cannot accumulate rounding error.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// CMS access
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER // full access, including managing other admins
  STAFF // day-to-day catalogue and order management (Njomza)
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         AdminRole @default(STAFF)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT // not visible on the storefront
  ACTIVE
  ARCHIVED // kept for order history, hidden everywhere else
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  status      ProductStatus @default(DRAFT)

  // Base price. A variant may override it.
  pricePence Int @map("price_pence")

  // Shown struck through next to the price. Purely presentational: the actual
  // discount a customer receives comes from an active Sale.
  compareAtPence Int? @map("compare_at_pence")

  sku      String? @unique
  // How many there are. For clothes sold in colours or sizes it is the total
  // of the variants' stock, kept in step whenever the Details tab is saved,
  // so the products list and the export read one number.
  stock    Int     @default(0)
  featured Boolean @default(false)

  // Postage. The weight is the piece in its own wrapping - shoppers see it
  // under Need to know - and with the size it goes as and, for a letter, how
  // thick it is, prices its parcel at checkout. Whatever is left empty comes
  // from its category's usual postage.
  weightGrams Int?        @map("weight_grams")
  parcelSize  ParcelSize? @map("parcel_size")
  thicknessMm Int?        @map("thickness_mm")

  // Where it sits in the shop and the admin list, highest first - set by
  // dragging it on the products list. A sequence, so a new product, however
  // it is made, takes the highest key and lands on top; a move only shuffles
  // the keys of the rows it passes, so they stay below every new one.
  sortKey Int @default(autoincrement()) @map("sort_key")

  // --- handmade / craft specifics ---

  // Free text rather than structured numbers: a non-technical editor can write
  // "20cm x 15cm, 8cm deep" or "fits a 30cm cushion" without being forced into
  // fields that do not suit every piece.
  dimensions String?
  materials  String?

  // Clothes only: the colours and the sizes a shopper chooses from, in the
  // order they are shown. Each colour in each size is a variant, with stock of
  // its own. Kept when a piece leaves Clothes, but offered only within it.
  colours          String[] @default([])
  sizes            String[] @default([])
  careInstructions String?  @map("care_instructions")

  // A one-of-a-kind piece. Shown as such on the storefront, and it is a
  // deliberate flag rather than inferring it from stock == 1, which is also
  // true of an ordinary item that has nearly sold out.
  oneOfAKind Boolean @default(false) @map("one_of_a_kind")

  // Made to order: not held in stock, so the stock count is not enforced at
  // checkout and the lead time is shown to the customer instead.
  madeToOrder  Boolean @default(false) @map("made_to_order")
  leadTimeDays Int?    @map("lead_time_days")

  // VAT charged on this product, as a whole percent. Per product, not per
  // shop: cards carry the standard 20%, children's clothing is zero-rated.
  vatRate Int @default(20) @map("vat_rate")

  images         ProductImage[]
  variants       ProductVariant[]
  categories     CategoryProduct[]
  favourites     Favourite[]
  costLines      CostLine[]
  priceListEntry PriceListEntry?
  sales          SaleProduct[]
  orderItems     OrderItem[]
  questions      Question[]
  basketLines    BasketLine[]

  // "You may also like": the pieces Njomza chose for this one, and the
  // products that chose this one.
  alsoLike     AlsoLike[] @relation("AlsoLikeFrom")
  alsoLikedFor AlsoLike[] @relation("AlsoLikeTo")

  // What a shopper can choose on a card or bookmark: a printed message,
  // personalisation, packs. Nothing here for anything else.
  customisation         ProductCustomisation?
  personalisationFields PersonalisationField[]
  packs                 ProductPack[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([status, sortKey])
  @@map("products")
}

/**
 * A piece chosen to show under "You may also like" on a product's page, in
 * the order it was chosen. Gone with either product; the page fills any gap
 * from the same categories.
 */
model AlsoLike {
  productId String @map("product_id")
  pieceId   String @map("piece_id")
  position  Int    @default(0)

  product Product @relation("AlsoLikeFrom", fields: [productId], references: [id], onDelete: Cascade)
  piece   Product @relation("AlsoLikeTo", fields: [pieceId], references: [id], onDelete: Cascade)

  @@id([productId, pieceId])
  @@index([pieceId])
  @@map("also_like")
}

// ---------------------------------------------------------------------------
// Customisation - cards and bookmarks only (see src/lib/customisation)
// ---------------------------------------------------------------------------

// How a card or bookmark can be made up. No row means nothing is offered.
// Every extra is charged per card, so a pack of four pays it four times.
model ProductCustomisation {
  productId String @id @map("product_id")

  // A message printed inside.
  message           Boolean @default(false)
  messagePricePence Int     @default(0) @map("message_price_pence")
  messageMaxLength  Int     @default(300) @map("message_max_length")

  // Personalisation: what can be personalised is the product's
  // PersonalisationField rows. Required means it is only sold personalised.
  personalisation           Boolean @default(false)
  personalisationPricePence Int     @default(0) @map("personalisation_price_pence")
  personalisationRequired   Boolean @default(false) @map("personalisation_required")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_customisations")
}

enum PersonalisationKind {
  TEXT // typed: a name; maxLength applies
  CHOICE // chosen from `choices`: an initial, a star sign
}

// One thing a shopper personalises, e.g. "Name" or "Zodiac sign".
model PersonalisationField {
  id        String              @id @default(cuid())
  productId String              @map("product_id")
  label     String
  kind      PersonalisationKind
  maxLength Int?                @map("max_length")
  choices   String[]
  position  Int                 @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("personalisation_fields")
}

// A pack of the same card, at its own price. The single card is the
// product itself, at the product's price.
model ProductPack {
  id         String @id @default(cuid())
  productId  String @map("product_id")
  cards      Int
  pricePence Int    @map("price_pence")
  position   Int    @default(0)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  basketLines BasketLine[]

  @@unique([productId, cards])
  @@map("product_packs")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  url       String
  alt       String?
  position  Int     @default(0)
  width     Int?
  height    Int?

  /// Perceptual hash, so a photo in Njomza's price lists can be matched to
  /// this one. Filled by the price-list import; null for photos uploaded
  /// since, which then match on their product's name alone.
  phash String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  homeTiles HomeTile[]

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String @map("product_id")

  // One colour in one size of a piece of clothing; null where the piece has
  // no colours, or no sizes. Always one of the product's own colours and
  // sizes - the Details tab keeps them in step.
  colour String?
  size   String?

  // "Lupin / 3-4 years": what an order line will snapshot as variant_name.
  name String

  sku        String? @unique
  // The price Shopify sold this size at, where it differed. Kept, not used:
  // every colour and size sells at the product's own price.
  pricePence Int?    @map("price_pence")
  stock      Int     @default(0)
  position   Int     @default(0)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  basketLines BasketLine[]

  @@index([productId])
  @@map("product_variants")
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  /// Its place among its siblings, read lowest first, as dragged on the
  /// categories page. A sequence, so a new category lands last in its group;
  /// a move hands the group's keys round. See src/lib/categories/ordering.ts.
  position    Int     @default(autoincrement())

  // Self-relation for sub-categories.
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products CategoryProduct[]

  /// Its usual costs, copied into a piece to start that piece's costing from.
  costLines CategoryCostLine[]

  /// Home page tiles and the button leading here.
  homeTiles     HomeTile[]
  homeButtonFor HomePage[] @relation("HomeButton")

  // Its usual postage: what a piece here, or in a type beneath it, goes by
  // when it has none of its own. Read live, never copied, so changing it
  // moves every piece using it.
  usualGrams       Int?        @map("usual_grams")
  usualParcelSize  ParcelSize? @map("usual_parcel_size")
  usualThicknessMm Int?        @map("usual_thickness_mm")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

/**
 * One thing that goes into making and sending a product: a card and
 * envelope, a skein of yarn, the postage.
 * The lines ARE the costing - a product with none has not been costed yet.
 * The unit cost is in pence like every other amount; the quantity is in
 * HUNDREDTHS, because yarn is bought by the half skein and 2.5 of them is a
 * real quantity. Integer throughout, so a cost is exact by construction.
 */
model CostLine {
  id        String @id @default(cuid())
  productId String @map("product_id")
  label     String

  unitPence          Int @map("unit_pence")
  quantityHundredths Int @default(100) @map("quantity_hundredths")
  position           Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("cost_lines")
}

/**
 * A line of a category's usual costs - card and envelope, bag, postage.
 * Shaped like CostLine, since it is copied into one; never linked, so
 * changing it changes nothing already priced.
 */
model CategoryCostLine {
  id         String @id @default(cuid())
  categoryId String @map("category_id")
  label      String

  unitPence          Int @map("unit_pence")
  quantityHundredths Int @default(100) @map("quantity_hundredths")
  position           Int @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("category_cost_lines")
}

/**
 * A costed row from Njomza's 2023 price lists, brought in so it can be matched
 * to a product rather than typed in again.
 * The lists identify each piece by photograph alone - there is no name or
 * code column - so matching is by the photo. Confident matches are attached
 * on import; the rest wait here to be chosen by eye.
 */
model PriceListEntry {
  id String @id @default(cuid())

  /// Where it came from, e.g. "Cards / Birthday Cards / row 8".
  source String
  /// Any words written in the photo column, which is all the naming there is.
  note   String?

  photoUrl      String? @map("photo_url")
  /// Perceptual hash of the photo, compared against the catalogue's photos.
  photoHash     String? @map("photo_hash")
  photoFilename String? @map("photo_filename")

  vatRate    Int  @map("vat_rate")
  /// Her price at the time, inc VAT. Shown for reference; never applied.
  pricePence Int  @map("price_pence")
  /// [{ label, unitPence, quantityHundredths }]
  lines      Json

  /// Whose costing this became. Unique: one sheet row, one product.
  productId String?  @unique @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("price_list_entries")
}

/**
 * The home page's editable content: one row, always id "home".
 * A singleton table rather than a key-value settings bag, so each field has a
 * type and the form can be validated like any other. Everything the page
 * shows that is not simply the catalogue lives here.
 */
/**
 * A question a shopper sent: about a piece, from its page, or about anything,
 * from the Contact page. Answered by email from the admin's Questions list -
 * the shop sends no email itself yet. Kept until deleted.
 */
model Question {
  id String @id @default(cuid())

  // The piece it is about, and its name when it was asked: a piece renamed or
  // deleted since must not change what the question says it was about.
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?  @map("product_name")

  name    String
  email   String
  message String

  // When it was marked answered; null while it waits.
  answeredAt DateTime? @map("answered_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // How many one address sent in the last hour; what waits, newest first.
  @@index([email, createdAt])
  @@index([answeredAt, createdAt])
  @@map("questions")
}

model HomePage {
  id String @id @default("home")

  /// The round badges under the header. They are artwork, so only shown or not.
  showBadges Boolean @default(true) @map("show_badges")

  /// The sage banner's words. Empty takes the banner off.
  bannerText String @default("Start with who you’re thinking of") @map("banner_text")

  /// The quiet band above the pieces. Empty takes the band off.
  bandText String @default("Our most-loved handmade pieces, from friendship to forever love, for every heartfelt occasion.") @map("band_text")

  /// The button beneath the pieces: its words, and where it leads - a
  /// category, by id so renaming its address cannot break it, or an address.
  /// Both empty (the category deleted) leads to the whole shop.
  ctaLabel      String    @map("cta_label")
  ctaCategoryId String?   @map("cta_category_id")
  ctaCategory   Category? @relation("HomeButton", fields: [ctaCategoryId], references: [id], onDelete: SetNull)
  ctaHref       String?   @map("cta_href")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_page")
}

/// A photo tile on the home page, in blocks of five. None at all means the
/// page has never been saved, and shows DEFAULT_TILES.
model HomeTile {
  id       String @id @default(cuid())
  position Int
  label    String

  /// Where it leads, as the button does: a category or an address.
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  href       String?

  /// Its photo: one of the shop's own, or one uploaded for it. Neither (the
  /// photo deleted since) takes the first piece's in the category it leads to.
  productImageId String?       @map("product_image_id")
  productImage   ProductImage? @relation(fields: [productImageId], references: [id], onDelete: SetNull)
  photoId        String?       @map("photo_id")
  photo          HomePhoto?    @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([position])
  @@map("home_tiles")
}

/// A photo uploaded for the home page rather than for a product. Deleted,
/// with its file, once a save leaves no tile using it.
model HomePhoto {
  id        String     @id @default(cuid())
  url       String
  createdAt DateTime   @default(now()) @map("created_at")
  tiles     HomeTile[]

  @@map("home_photos")
}

/**
 * A piece somebody has saved for later.
 * The pair is the key: saving the same thing twice is the same thing saved,
 * not a second row. Both sides cascade - a closed account and a deleted
 * product each take their saves with them.
 */
model Favourite {
  customerId String   @map("customer_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@index([customerId])
  @@map("favourites")
}

model CategoryProduct {
  categoryId String @map("category_id")
  productId  String @map("product_id")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId])
  @@map("category_products")
}

// ---------------------------------------------------------------------------
// Sales and discounts
// ---------------------------------------------------------------------------

enum SaleType {
  PERCENTAGE // `value` is a percentage, 1-100
  FIXED_AMOUNT // `value` is pence off
}

// A price promotion applied to a set of products. One Sale row attached to many
// products is what makes a batch sale a batch: Njomza selects products in the
// CMS and they all join the same Sale.
model Sale {
  id       String    @id @default(cuid())
  name     String
  type     SaleType
  value    Int
  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at") // null = runs until switched off
  active   Boolean   @default(true)

  products SaleProduct[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, startsAt, endsAt])
  @@map("sales")
}

model SaleProduct {
  saleId    String @map("sale_id")
  productId String @map("product_id")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([saleId, productId])
  @@map("sale_products")
}

// A code the customer types at checkout. Distinct from a Sale, which needs no
// code and applies automatically.
model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique
  type          SaleType
  value         Int
  minSpendPence Int?      @map("min_spend_pence")
  usageLimit    Int?      @map("usage_limit") // null = unlimited
  usedCount     Int       @default(0) @map("used_count")
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  active        Boolean   @default(true)

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("discount_codes")
}

// ---------------------------------------------------------------------------
// Customers and orders
// ---------------------------------------------------------------------------

model Customer {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
  phone String?

  // Null for a customer who has never set one: a guest checkout creates the
  // row, and an account is something they may add later against the same
  // email rather than a second identity.
  passwordHash String? @map("password_hash")

  stripeCustomerId String? @unique @map("stripe_customer_id")
  marketingOptIn   Boolean @default(false) @map("marketing_opt_in")

  orders     Order[]
  addresses  Address[]
  favourites Favourite[]
  basket     Basket?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model Address {
  id         String  @id @default(cuid())
  customerId String? @map("customer_id")
  name       String
  line1      String
  line2      String?
  city       String
  county     String?
  postcode   String
  country    String  @default("GB")
  phone      String?

  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingForOrders Order[]   @relation("OrderShippingAddress")
  billingForOrders  Order[]   @relation("OrderBillingAddress")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("addresses")
}

enum OrderStatus {
  PENDING // checkout started, payment not confirmed
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  // Short human-readable reference shown to the customer, e.g. NYK-1042.
  // Numbered by the database from a sequence starting at 1001, so two
  // checkouts at once can never be given the same number.
  orderNumber String      @unique @default(dbgenerated("('NYK-'::text || nextval('order_number_seq'::regclass))")) @map("order_number")
  status      OrderStatus @default(PENDING)

  // The basket that made it, while it waits to be paid: going back to change
  // something updates this order rather than making a second.
  basketId String? @map("basket_id")
  basket   Basket? @relation(fields: [basketId], references: [id], onDelete: SetNull)

  // Sent straight to somebody else: the shipping address is theirs, the
  // note goes in the parcel, and the delivery note can leave out the prices.
  gift       Boolean @default(false)
  giftNote   String? @map("gift_note")
  hidePrices Boolean @default(false) @map("hide_prices")

  // The delivery option's name as it was chosen, copied: renaming or
  // deleting the option must not change what an old order says.
  shippingMethod String? @map("shipping_method")

  // The parcel checkout priced, copied, so the postage bought is the postage
  // charged for: its size, its weight packed, and a letter's thickness.
  parcelSize  ParcelSize? @map("parcel_size")
  parcelGrams Int?        @map("parcel_grams")
  parcelMm    Int?        @map("parcel_mm")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Captured separately so guest checkout works without a Customer row.
  email      String

  subtotalPence Int    @map("subtotal_pence")
  discountPence Int    @default(0) @map("discount_pence")
  shippingPence Int    @default(0) @map("shipping_pence")
  taxPence      Int    @default(0) @map("tax_pence")
  totalPence    Int    @map("total_pence")
  currency      String @default("GBP")

  discountCodeId String?       @map("discount_code_id")
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  shippingAddressId String?  @map("shipping_address_id")
  shippingAddress   Address? @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddressId  String?  @map("billing_address_id")
  billingAddress    Address? @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)

  stripeCheckoutSessionId String? @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @unique @map("stripe_payment_intent_id")

  trackingNumber String? @map("tracking_number")
  carrier        String?
  notes          String?

  items OrderItem[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  paidAt      DateTime? @map("paid_at")
  fulfilledAt DateTime? @map("fulfilled_at")

  @@index([status])
  @@index([createdAt])
  @@index([basketId])
  @@map("orders")
}

// Line items snapshot their product details. A product renamed, repriced or
// archived later must not retroactively change what an old order says it sold.
model OrderItem {
  id      String @id @default(cuid())
  orderId String @map("order_id")

  productId String?         @map("product_id")
  variantId String?         @map("variant_id")
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String  @map("product_name")
  variantName String? @map("variant_name")
  sku         String?
  imageUrl    String? @map("image_url")

  unitPricePence Int @map("unit_price_pence")
  quantity       Int
  totalPence     Int @map("total_pence")

  // What was chosen, in words, as the shopper saw it: [{ label, value }] -
  // "Size: 2-3 years", "Inside the card: Printed: ...". Labels, not ids, so
  // a personalisation field renamed later cannot change what was ordered.
  details Json @default("[]")
  // Copied, so the VAT on an old order never moves with the product's.
  vatRate Int  @map("vat_rate")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Basket (see src/lib/basket)
// ---------------------------------------------------------------------------

// A shopper's basket. A cookie names a guest's; a signed-in shopper's is
// joined to their account, and what a guest added is folded into it.
model Basket {
  id         String    @id @default(cuid())
  customerId String?   @unique @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  lines  BasketLine[]
  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("baskets")
}

// One piece as chosen. It keeps the choices, never a price: the price is
// worked out afresh from the product whenever the basket is shown, so a sale
// starting or ending shows at once.
model BasketLine {
  id        String  @id @default(cuid())
  basketId  String  @map("basket_id")
  productId String  @map("product_id")
  // A piece of clothing's colour and size.
  variantId String? @map("variant_id")
  // A pack of cards; null is the single card.
  packId    String? @map("pack_id")

  // "Blank inside" or "Printed message"; null where no message is offered.
  message         String?
  messageText     String  @default("") @map("message_text")
  personalise     Boolean @default(false)
  // Personalisation field id to what was typed or chosen.
  personalisation Json    @default("{}")

  quantity Int

  // The choices as one value, so the same piece with the same choices is
  // one line, its quantity added to.
  key String

  // What one cost when it went in. Only to tell the shopper a price has
  // changed since; never what they are charged.
  addedPricePence Int @map("added_price_pence")

  basket  Basket          @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  pack    ProductPack?    @relation(fields: [packId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([basketId, key])
  @@index([productId])
  @@map("basket_lines")
}

// ---------------------------------------------------------------------------
// Shipping and store configuration
// ---------------------------------------------------------------------------

model ShippingRate {
  id            String  @id @default(cuid())
  name          String // "Royal Mail 2nd Class"
  // The one price, for an option not priced by size and weight.
  pricePence    Int     @map("price_pence")
  // Priced from its bands for the parcel in the basket, rather than at the
  // one price. Either is kept while the other is in use.
  byWeight      Boolean @default(false) @map("by_weight")
  // Order subtotal at or above which this rate becomes free. null = never free.
  freeOverPence Int?    @map("free_over_pence")
  minDays       Int?    @map("min_days")
  maxDays       Int?    @map("max_days")
  active        Boolean @default(true)
  position      Int     @default(0)

  bands ShippingBand[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shipping_rates")
}

/// Royal Mail's sizes, smallest first: what a parcel goes as, and what a price is for.
enum ParcelSize {
  LETTER
  LARGE_LETTER
  SMALL_PARCEL
  MEDIUM_PARCEL
}

/// A line of an option's price list: this size, up to and including this weight, costs this much.
model ShippingBand {
  id         String       @id @default(cuid())
  rateId     String       @map("rate_id")
  rate       ShippingRate @relation(fields: [rateId], references: [id], onDelete: Cascade)
  size       ParcelSize
  upToGrams  Int          @map("up_to_grams")
  pricePence Int          @map("price_pence")

  @@unique([rateId, size, upToGrams])
  @@map("shipping_bands")
}

// How postage is worked out, beyond the price lists. One row, id "delivery",
// made on the first save; until then the defaults in src/lib/delivery/parcel.ts.
model DeliverySettings {
  id String @id @default("delivery")

  // What a piece not weighed yet counts as.
  unweighedGrams Int        @default(500) @map("unweighed_grams")
  unweighedSize  ParcelSize @default(SMALL_PARCEL) @map("unweighed_size")

  // The envelope or box each size goes in, added once to a parcel.
  letterPackGrams       Int @default(10) @map("letter_pack_grams")
  letterPackMm          Int @default(1) @map("letter_pack_mm")
  largeLetterPackGrams  Int @default(40) @map("large_letter_pack_grams")
  largeLetterPackMm     Int @default(2) @map("large_letter_pack_mm")
  smallParcelPackGrams  Int @default(110) @map("small_parcel_pack_grams")
  mediumParcelPackGrams Int @default(300) @map("medium_parcel_pack_grams")

  // When the price lists were last checked against Royal Mail's own.
  pricesCheckedOn DateTime? @map("prices_checked_on")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_settings")
}

// Simple key/value store for things Njomza can edit without a deploy:
// store name, contact email, announcement banner, social links.
model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}
