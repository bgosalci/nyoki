# Postgres. Local dev needs only DATABASE_URL.
# On Vercel + Neon, DATABASE_URL_UNPOOLED is also set and the Prisma CLI
# prefers it for migrations - see the comment in prisma.config.ts.
DATABASE_URL="postgresql://user:password@localhost:5432/nyoki?schema=public"

# Stripe. Test keys locally, live keys only in Vercel production env.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Vercel Blob, for product photos. Leave unset locally and uploads go to
# public/uploads instead. Required in production - the app refuses to start
# without it rather than write photos to Vercel's ephemeral disk.
BLOB_READ_WRITE_TOKEN=""

# Absolute base URL, used for Stripe redirect URLs and canonical links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign CMS session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""
